# Silence npm install warnings.
#
# prebuild-install@7.1.3 (a transitive dep of better-sqlite3) is marked
# "No longer maintained" upstream, but 7.1.3 is the *latest* release and is
# exactly what better-sqlite3@12 requires for its prebuilt binaries. There is
# no newer version to upgrade to, so we silence the deprecation warning rather
# than force a slow source build.
#
# loglevel=error keeps errors and notices visible while hiding all `warn`.
loglevel=error
