{
  "name": "@genegulanesjr/lapis",
  "version": "1.1.3",
  "description": "💎 LaPis — Persistent memory for the Pi coding agent. One SQLite DB, zero cloud, zero API keys.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/GeneGulanesJr/LaPis#readme",
  "bugs": {
    "url": "https://github.com/GeneGulanesJr/LaPis/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeneGulanesJr/LaPis.git"
  },
  "bin": {
    "lapis": "./memory-store.js",
    "memory-store": "./memory-store.js",
    "lapis-mcp": "./memory-store.js",
    "lapis-cc": "./memory-store.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "memory-store.js",
    "cli.js",
    "postinstall.js",
    "schema.sql",
    "config.js",
    "constants.js",
    "db.js",
    "utils.js",
    "parse-code.js",
    "ast-patterns.js",
    "git-analysis.js",
    "commands/",
    "data-access/",
    "services/",
    "src/",
    "src/claude-code/",
    "src/hooks-engine/",
    "extensions/",
    "skills/",
    "grammars/",
    "docs/"
  ],
  "type": "commonjs",
  "main": "./memory-store.js",
  "exports": {
    ".": "./memory-store.js",
    "./cli": "./cli.js",
    "./memory-store": "./memory-store.js",
    "./claude-code": "./src/claude-code/hooks.js",
    "./hooks-engine": "./src/hooks-engine/index.js",
    "./extension": "./extensions/memory-layer/index.ts",
    "./code-analysis": "./src/code-analysis/index.js",
    "./code-index": "./src/code-index/index.js",
    "./doc-index": "./src/doc-index/index.js",
    "./memory-domain": "./src/memory-domain/index.js",
    "./trust-sync": "./src/trust-sync/index.js",
    "./platform/storage": "./src/platform/storage/index.js",
    "./platform/protocol/envelope": "./src/platform/protocol/envelope.js",
    "./platform/protocol/llm-format": "./src/platform/protocol/llm-format.js",
    "./platform/protocol/compact-format": "./src/platform/protocol/compact-format.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "postinstall": "node postinstall.js",
    "audit:patch": "node postinstall.js",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:diff": "stryker run --mutate \"src/**/*.js\" --incremental",
    "bench:pi-paired": "node bench/bench-pi-paired.js",
    "bench:pi-realworld": "node bench/realworld/bench-pi-realworld.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "ignore": "^7.0.5",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tree-sitter-cli": "^0.26.8",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-sql": "^0.1.0",
    "tree-sitter-typescript": "^0.23.2",
    "typebox": "^1.1.37",
    "typescript": "^6.0.3",
    "protobufjs": "^7.6.5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "qs": "^6.15.3",
    "brace-expansion": "^5.0.9",
    "protobufjs": "^7.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
